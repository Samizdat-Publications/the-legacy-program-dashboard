{"id": "tybOi4hjZFQ", "segments": [{"t": 0.7, "text": "Hi guys."}, {"t": 1.53, "text": "Welcome."}, {"t": 2.63, "text": "This is a guided breathing session."}, {"t": 5.5, "text": "Relax to the deepest."}, {"t": 7.77, "text": "Lay or sit down."}, {"t": 9.5, "text": "Whatever it takes…"}, {"t": 10.87, "text": "Relax."}, {"t": 12.83, "text": "Are you ready?"}, {"t": 14.37, "text": "Here we go."}, {"t": 18.4, "text": "Round number one. "}, {"t": 21.53, "text": "Breathe in. "}, {"t": 23.0, "text": "Breathe out."}, {"t": 24.43, "text": "Breathe in."}, {"t": 25.83, "text": "Breathe out."}, {"t": 27.9, "text": "Just go with the flow of the breath. "}, {"t": 34.03, "text": "In."}, {"t": 35.53, "text": "Out."}, {"t": 37.07, "text": "In."}, {"t": 38.77, "text": "Out."}, {"t": 40.43, "text": "In. "}, {"t": 41.57, "text": "Out."}, {"t": 43.33, "text": "In."}, {"t": 44.93, "text": "Out."}, {"t": 45.97, "text": "Into the belly."}, {"t": 47.23, "text": "Into the chest."}, {"t": 48.57, "text": "And let go."}, {"t": 49.97, "text": "Like a wave."}, {"t": 52.73, "text": "Make it circular. "}, {"t": 55.8, "text": "Fully in. "}, {"t": 57.2, "text": "Letting go."}, {"t": 58.93, "text": "Just keep on going. "}, {"t": 64.3, "text": "No pause between inhalation and exhalation."}, {"t": 80.23, "text": "Ten more."}, {"t": 81.27, "text": "Fully in."}, {"t": 82.5, "text": "Letting go."}, {"t": 99.23, "text": "Five more."}, {"t": 100.5, "text": "Let's give it all we got."}, {"t": 111.17, "text": "Last one. "}, {"t": 112.1, "text": "Fully in."}, {"t": 113.97, "text": "And let go."}, {"t": 116.13, "text": "All right."}, {"t": 117.03, "text": "One minute breath hold from now on. "}, {"t": 121.87, "text": "Be in this moment. "}, {"t": 126.2, "text": "Let the body do what the body is capable of doing."}, {"t": 134.2, "text": "Be aware of your heartbeat.. "}, {"t": 137.03, "text": "Slow it down,"}, {"t": 138.8, "text": "and just be in this moment."}, {"t": 145.2, "text": "Let that relaxation spread down to your toes,"}, {"t": 148.8, "text": "into your fingertips,"}, {"t": 151.2, "text": "to the base of your neck and head. "}, {"t": 157.07, "text": "You are almost there."}, {"t": 159.47, "text": "Do you want to prolong your breath hold?"}, {"t": 161.97, "text": "Pause the video now and continue when you feel the urge to breathe."}, {"t": 169.13, "text": "Ok."}, {"t": 169.83, "text": "Recovery breath in..."}, {"t": 171.47, "text": "Five."}, {"t": 172.23, "text": "Four. "}, {"t": 173.23, "text": "Three."}, {"t": 174.13, "text": "Two."}, {"t": 175.33, "text": "One."}, {"t": 176.67, "text": "Take a deep breath in and hold for 15 seconds."}, {"t": 189.5, "text": "Exhale in three..."}, {"t": 191.97, "text": "Two."}, {"t": 192.7, "text": "One."}, {"t": 193.63, "text": "Let it go."}, {"t": 195.97, "text": "Round number two. "}, {"t": 198.33, "text": "Back into that rhythm. "}, {"t": 199.97, "text": "Breathe in. "}, {"t": 201.3, "text": "Breathe out."}, {"t": 202.83, "text": "Breathe in. "}, {"t": 204.3, "text": "Breathe out."}, {"t": 215.77, "text": "In."}, {"t": 217.23, "text": "Out."}, {"t": 218.57, "text": "In. "}, {"t": 220.07, "text": "Out."}, {"t": 221.8, "text": "In."}, {"t": 223.2, "text": "Out."}, {"t": 224.3, "text": "Into the belly,"}, {"t": 225.87, "text": "Into the chest,"}, {"t": 227.03, "text": "and let go."}, {"t": 228.53, "text": "Like a wave."}, {"t": 231.17, "text": "Make it circular.. "}, {"t": 234.3, "text": "Fully in. "}, {"t": 235.73, "text": "Letting go. "}, {"t": 237.5, "text": "Just keep on going."}, {"t": 242.83, "text": "No pause between inhalation and exhalation."}, {"t": 250.03, "text": "In with peace."}, {"t": 252.1, "text": "Out with stress "}, {"t": 261.97, "text": "Ten more."}, {"t": 263.4, "text": "Fully in."}, {"t": 264.17, "text": "Letting go."}, {"t": 265.63, "text": "Nice deep circular breaths."}, {"t": 277.23, "text": "Five more. "}, {"t": 278.3, "text": "Let's give it all we got."}, {"t": 289.53, "text": "Last one, fully in..."}, {"t": 292.67, "text": "and on the exhale..."}, {"t": 294.73, "text": "Stop."}, {"t": 296.4, "text": "One a half minute breath hold from now on."}, {"t": 303.3, "text": "Feel. "}, {"t": 304.17, "text": "Become aware of your body."}, {"t": 312.67, "text": "If your hands and feet are tingling or you feel your body temperature is changing,"}, {"t": 318.93, "text": "that's ok."}, {"t": 337.7, "text": "You're doing fantastic."}, {"t": 353.87, "text": "If you need to breathe before I give the cue, "}, {"t": 357.27, "text": "that's okay."}, {"t": 367.6, "text": "You are almost there."}, {"t": 372.67, "text": "Do you want to prolong your breath hold?"}, {"t": 375.43, "text": "Pause the video now and continue when you feel the urge to breathe."}, {"t": 383.33, "text": "When you are ready..."}, {"t": 385.33, "text": "Fully in,"}, {"t": 387.1, "text": "and hold for 15 seconds."}, {"t": 397.93, "text": "Exhale in three..."}, {"t": 399.97, "text": "Two."}, {"t": 401.2, "text": "One."}, {"t": 401.87, "text": "Let it go. "}, {"t": 404.27, "text": "Round number three. "}, {"t": 406.8, "text": "Back into that rhythm. "}, {"t": 408.77, "text": "Breathe in. "}, {"t": 410.1, "text": "Breathe out."}, {"t": 411.6, "text": "Breathe in. "}, {"t": 413.13, "text": "Breathe out. "}, {"t": 417.43, "text": "In with the relaxation. "}, {"t": 419.7, "text": "Out with the stress. "}, {"t": 424.33, "text": "In ."}, {"t": 425.8, "text": "Out."}, {"t": 427.4, "text": "In."}, {"t": 428.97, "text": "Out."}, {"t": 430.3, "text": "In. "}, {"t": 431.6, "text": "Out. "}, {"t": 433.0, "text": "Into the belly,"}, {"t": 434.3, "text": "into the chest,"}, {"t": 435.47, "text": "and let go. "}, {"t": 437.17, "text": "Like a wave. "}, {"t": 439.67, "text": "Make it circular."}, {"t": 442.83, "text": "Fully in. "}, {"t": 444.2, "text": "Letting go "}, {"t": 446.17, "text": "Just keep on going."}, {"t": 451.27, "text": "No pause between inhalation and exhalation. "}, {"t": 458.7, "text": "In with peace"}, {"t": 460.3, "text": "Out with stress."}, {"t": 470.67, "text": "Ten more. "}, {"t": 471.9, "text": "Fully in."}, {"t": 472.83, "text": "Letting go."}, {"t": 477.27, "text": "Nice deep circular breaths."}, {"t": 486.1, "text": "Five more."}, {"t": 487.27, "text": "Let's give it all we got."}, {"t": 498.07, "text": "Last one. "}, {"t": 499.0, "text": "Fully in."}, {"t": 501.2, "text": "And on the exhale..."}, {"t": 503.37, "text": "Stop."}, {"t": 504.87, "text": "One and a half minute breath hold from now on."}, {"t": 520.77, "text": "Become aware of the blood running through your veins,"}, {"t": 525.63, "text": "your heart beating."}, {"t": 528.0, "text": "Feel. "}, {"t": 562.97, "text": "Thirty seconds left."}, {"t": 576.07, "text": "You are almost there. "}, {"t": 581.47, "text": "Do you want to prolong your breath hold?"}, {"t": 584.17, "text": "Pause the video now and continue when you feel the urge to breathe."}, {"t": 592.3, "text": "Alright."}, {"t": 593.7, "text": "Breathe in."}, {"t": 595.13, "text": "And hold for 15 seconds."}, {"t": 606.9, "text": "Exhale in three..."}, {"t": 609.3, "text": "Two. "}, {"t": 610.27, "text": "One. "}, {"t": 611.2, "text": "Let it go."}, {"t": 615.0, "text": "Let your breathing return to normal as you finish up the round."}, {"t": 620.17, "text": "Move your body bit by bit,"}, {"t": 622.8, "text": "starting with your fingers and your toes."}, {"t": 626.17, "text": "Let your breathing normalise. "}, {"t": 631.67, "text": "If you liked this guided breathing session,"}, {"t": 635.23, "text": "we’ve got more for you..."}, {"t": 636.8, "text": "We have a free app on our website"}, {"t": 640.57, "text": "Download it."}, {"t": 641.63, "text": "It’s good stuff."}, {"t": 645.17, "text": "Thanks for your time."}, {"t": 646.9, "text": "And I wish you a good night,"}, {"t": 648.7, "text": "or a good day,"}, {"t": 650.13, "text": "and a good life. "}, {"t": 652.0, "text": "All the love. "}, {"t": 653.03, "text": "All the power."}]}